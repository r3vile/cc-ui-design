<!--
    Main Screen — Espresso Machine
    4 icon buttons arranged in a compass layout around a center logo.
    Tap an icon to navigate to the corresponding sub-screen.
-->
<screen permanent="true">

    <styles>
        <style name="logo"
               text_color="#c_gold"
               text_opa="70%"
               text_letter_space="5"/>
    </styles>

    <view>
        <style name="scr_bg"/>

        <!-- ── Decorative ring ── -->
        <lv_obj align="center" width="#ring_diameter" height="#ring_diameter"
                clickable="false" scrollable="false">
            <style name="ring"/>
        </lv_obj>

        <!-- ── Center logo ── -->
        <lv_label text="ESPRESSO" align="center">
            <style name="logo"/>
        </lv_label>

        <!-- ── Coffee button (top) ── -->
        <lv_obj name="btn_coffee" align="center" x="0" y="-148"
                width="#icon_btn_size" height="#icon_btn_size"
                scrollable="false">
            <style name="icon_btn"/>
            <style name="icon_btn_pressed" selector="pressed"/>
            <lv_image src="icon_coffee" align="center">
                <style name="icon_img"/>
                <style name="icon_img_pressed" selector="pressed"/>
            </lv_image>
            <screen_load_event screen="screen_coffee"
                               trigger="clicked"
                               anim_type="move_left"
                               duration="350"/>
        </lv_obj>

        <!-- ── Steam button (right) ── -->
        <lv_obj name="btn_steam" align="center" x="148" y="0"
                width="#icon_btn_size" height="#icon_btn_size"
                scrollable="false">
            <style name="icon_btn"/>
            <style name="icon_btn_pressed" selector="pressed"/>
            <lv_image src="icon_steam" align="center">
                <style name="icon_img"/>
                <style name="icon_img_pressed" selector="pressed"/>
            </lv_image>
            <screen_load_event screen="screen_steam"
                               trigger="clicked"
                               anim_type="move_left"
                               duration="350"/>
        </lv_obj>

        <!-- ── Hot Water button (bottom) ── -->
        <lv_obj name="btn_water" align="center" x="0" y="148"
                width="#icon_btn_size" height="#icon_btn_size"
                scrollable="false">
            <style name="icon_btn"/>
            <style name="icon_btn_pressed" selector="pressed"/>
            <lv_image src="icon_water" align="center">
                <style name="icon_img"/>
                <style name="icon_img_pressed" selector="pressed"/>
            </lv_image>
            <screen_load_event screen="screen_water"
                               trigger="clicked"
                               anim_type="move_left"
                               duration="350"/>
        </lv_obj>

        <!-- ── Settings button (left) ── -->
        <lv_obj name="btn_settings" align="center" x="-148" y="0"
                width="#icon_btn_size" height="#icon_btn_size"
                scrollable="false">
            <style name="icon_btn"/>
            <style name="icon_btn_pressed" selector="pressed"/>
            <lv_image src="icon_settings" align="center">
                <style name="icon_img"/>
                <style name="icon_img_pressed" selector="pressed"/>
            </lv_image>
            <screen_load_event screen="screen_settings"
                               trigger="clicked"
                               anim_type="move_left"
                               duration="350"/>
        </lv_obj>

    </view>
</screen>
