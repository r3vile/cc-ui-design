<screen>
	<styles>
		<style name="style_bg"
			bg_color="#bg_primary" bg_opa="100%"
			width="480" height="480"
			radius="240" border_width="0" pad_all="0"
		/>
		<style name="style_title"
			text_color="#text_primary" text_font="font_heading"
		/>
		<style name="style_scroll_container"
			bg_opa="0" border_width="0"
			pad_all="0"
			layout="flex" flex_flow="row"
			pad_column="12"
			flex_cross_place="center"
		/>
		<style name="style_play_btn"
			width="56" height="56" radius="28"
			bg_color="#accent" bg_opa="100%"
			border_width="0" pad_all="0"
		/>
		<style name="style_play_pressed"
			bg_opa="70%"
		/>
		<style name="style_play_icon"
			image_recolor="#bg_primary" image_recolor_opa="100%"
		/>
	</styles>

	<view style_layout="none">
		<style name="style_bg" />

		<!-- Back button -->
		<back_button align="center" x="-135" y="-130">
			<screen_load_event screen="screen_main"
				anim_type="fade_in" duration="300" />
		</back_button>

		<!-- Title -->
		<lv_label text="Coffee" align="center" y="-130">
			<style name="style_title" />
		</lv_label>

		<!-- Horizontally scrollable coffee types -->
		<lv_obj align="center" y="10" width="340" height="160">
			<style name="style_scroll_container" />

			<coffee_type_card icon="icon_espresso" label="Espresso" />
			<coffee_type_card icon="icon_cappuccino" label="Cappuccino" />
			<coffee_type_card icon="icon_lungo" label="Lungo" />
			<coffee_type_card icon="icon_americano" label="Americano" />
		</lv_obj>

		<!-- Play / Start button -->
		<lv_button align="center" y="155">
			<remove_style_all />
			<style name="style_play_btn" />
			<style name="style_play_pressed" selector="pressed" />
			<lv_image src="icon_play" align="center">
				<style name="style_play_icon" />
			</lv_image>
		</lv_button>
	</view>
</screen>
