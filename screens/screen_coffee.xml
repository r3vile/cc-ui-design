<!--
    Coffee Screen — Espresso Machine
    Displays a selectable coffee type with icon, name, and pagination dots.
    Back button at top, brew (play) button at bottom.
    On the real device, swipe gestures cycle types (handled in C code).
    In the viewer, the roller widget provides scroll-based selection.
-->
<screen permanent="true">

    <styles>
        <style name="coffee_icon_ring"
               radius="32767"
               bg_color="#c_gold"
               bg_opa="6%"
               border_width="1"
               border_color="#c_gold"
               border_opa="12%"/>

        <style name="coffee_name"
               text_color="#c_white"
               text_opa="85%"
               text_letter_space="3"/>

        <style name="brew_btn"
               radius="32767"
               bg_color="#c_gold"
               bg_opa="100%"
               shadow_width="20"
               shadow_color="#c_gold"
               shadow_opa="30%"
               shadow_spread="0"/>

        <style name="brew_btn_pressed"
               bg_color="#c_gold_dark"
               shadow_opa="50%"/>

        <style name="hint"
               text_color="#c_white"
               text_opa="20%"
               text_letter_space="2"/>

        <style name="roller_style"
               bg_opa="0%"
               border_width="0"
               text_color="#c_white"
               text_opa="30%"
               text_letter_space="3"/>

        <style name="roller_selected"
               bg_opa="0%"
               text_color="#c_white"
               text_opa="85%"/>
    </styles>

    <view>
        <style name="scr_bg"/>

        <!-- ── Back button ── -->
        <lv_obj align="top_mid" y="#nav_btn_y"
                width="#nav_btn_size" height="#nav_btn_size"
                scrollable="false">
            <style name="nav_btn"/>
            <style name="nav_btn_pressed" selector="pressed"/>
            <lv_label text="&#xF053;" align="center"
                      style_text_color="#c_white"
                      style_text_opa="50%"/>
            <screen_load_event screen="screen_main"
                               trigger="clicked"
                               anim_type="move_right"
                               duration="350"/>
        </lv_obj>

        <!-- ── Coffee type icon circle ── -->
        <lv_obj align="center" x="0" y="-60"
                width="#coffee_icon_size" height="#coffee_icon_size"
                scrollable="false" clickable="false">
            <style name="coffee_icon_ring"/>
            <!-- Bell as placeholder; replace with custom font including U+F0F4 (fa-coffee) -->
            <lv_label text="&#xF0F3;" align="center"
                      style_text_color="#c_gold"
                      style_text_opa="100%"/>
        </lv_obj>

        <!-- ── Coffee type name (roller for interactive selection) ── -->
        <lv_roller name="coffee_roller"
                   options="ESPRESSO\nDOPPIO\nAMERICANO\nCAPPUCCINO\nFLAT WHITE\nLATTE"
                   visible_row_count="1"
                   align="center" y="10"
                   width="240">
            <style name="roller_style"/>
            <style name="roller_selected" selector="selected"/>
        </lv_roller>

        <!-- ── Pagination dots ── -->
        <lv_obj align="center" y="50"
                width="content" height="content"
                style_layout="flex"
                style_flex_flow="row"
                style_pad_column="8"
                scrollable="false" clickable="false">

            <lv_obj width="#dot_active_w" height="#dot_size">
                <style name="dot_active"/>
            </lv_obj>
            <lv_obj width="#dot_size" height="#dot_size">
                <style name="dot"/>
            </lv_obj>
            <lv_obj width="#dot_size" height="#dot_size">
                <style name="dot"/>
            </lv_obj>
            <lv_obj width="#dot_size" height="#dot_size">
                <style name="dot"/>
            </lv_obj>
            <lv_obj width="#dot_size" height="#dot_size">
                <style name="dot"/>
            </lv_obj>
            <lv_obj width="#dot_size" height="#dot_size">
                <style name="dot"/>
            </lv_obj>
        </lv_obj>

        <!-- ── Swipe hint ── -->
        <lv_label text="SWIPE TO CHANGE" align="center" y="72">
            <style name="hint"/>
        </lv_label>

        <!-- ── Brew (play) button ── -->
        <lv_obj align="bottom_mid" y="-52"
                width="#action_btn_size" height="#action_btn_size"
                scrollable="false">
            <style name="brew_btn"/>
            <style name="brew_btn_pressed" selector="pressed"/>
            <lv_label text="&#xF04B;" align="center"
                      style_text_color="#c_bg"/>
        </lv_obj>

    </view>
</screen>
