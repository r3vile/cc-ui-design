<!--
    Steam Screen — Espresso Machine
    Circular progress arc showing temperature approaching 125°C target.
    Center: large temperature reading + target label + state indicator.
    No action button — user opens a manual steam valve.
-->
<screen permanent="true">

    <styles>
        <style name="temp_large"
               text_color="#c_white"
               text_opa="100%"/>

        <style name="temp_unit"
               text_color="#c_white"
               text_opa="40%"/>

        <style name="target_text"
               text_color="#c_white"
               text_opa="30%"
               text_letter_space="2"/>

        <style name="state_text"
               text_color="#c_orange"
               text_letter_space="3"/>

        <style name="state_dot"
               radius="32767"
               bg_color="#c_orange"
               bg_opa="100%"/>

        <style name="valve_hint"
               text_color="#c_white"
               text_opa="18%"
               text_letter_space="2"/>
    </styles>

    <view>
        <style name="scr_bg"/>

        <!-- ── Back button ── -->
        <lv_obj align="top_mid" y="#nav_btn_y"
                width="#nav_btn_size" height="#nav_btn_size"
                scrollable="false">
            <style name="nav_btn"/>
            <style name="nav_btn_pressed" selector="pressed"/>
            <lv_label text="&#xF053;" align="center"
                      style_text_color="#c_white"
                      style_text_opa="50%"/>
            <screen_load_event screen="screen_main"
                               trigger="clicked"
                               anim_type="move_right"
                               duration="350"/>
        </lv_obj>

        <!-- ── Progress arc ──
             270° sweep from 135° to 45° (gap at bottom).
             Range 0–125 maps to 0–125°C. -->
        <lv_arc name="steam_arc"
                align="center"
                width="#arc_diameter" height="#arc_diameter"
                bg_start_angle="135"
                bg_end_angle="45"
                start_angle="135"
                min_value="0"
                max_value="125"
                value="89"
                bind_value="steam_temp"
                clickable="false"
                style_arc_width="#arc_width"
                style_arc_color="#c_white"
                style_arc_opa="5%">
            <style name="arc_indicator_orange" selector="indicator"/>
            <style name="arc_knob_hidden" selector="knob"/>
        </lv_arc>

        <!-- ── Temperature display ── -->
        <lv_obj align="center" y="0"
                width="content" height="content"
                style_layout="flex"
                style_flex_flow="row"
                style_flex_cross_place="start"
                style_pad_column="2"
                scrollable="false" clickable="false"
                style_bg_opa="0%">
            <lv_label name="steam_temp_val"
                      bind_text="steam_temp"
                      bind_text-fmt="%d">
                <style name="temp_large"/>
            </lv_label>
            <lv_label text="°C">
                <style name="temp_unit"/>
            </lv_label>
        </lv_obj>

        <!-- ── Target label ── -->
        <lv_label text="TARGET 125°C" align="center" y="36">
            <style name="target_text"/>
        </lv_label>

        <!-- ── State indicator (dot + text) ── -->
        <lv_obj name="steam_state_row" align="center" y="60"
                width="content" height="content"
                style_layout="flex"
                style_flex_flow="row"
                style_flex_cross_place="center"
                style_pad_column="8"
                scrollable="false" clickable="false"
                style_bg_opa="0%">
            <lv_obj name="steam_dot" width="6" height="6">
                <style name="state_dot"/>
            </lv_obj>
            <lv_label name="steam_state_label"
                      bind_text="steam_state">
                <style name="state_text"/>
            </lv_label>
        </lv_obj>

        <!-- ── Valve hint ── -->
        <lv_label text="OPEN VALVE WHEN READY"
                  align="bottom_mid" y="-62">
            <style name="valve_hint"/>
        </lv_label>

    </view>
</screen>
