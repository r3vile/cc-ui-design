<component>
	<api>
		<prop name="icon" type="image" default="icon_coffee" />
	</api>

	<styles>
		<style name="style_btn"
			width="80" height="80"
			radius="40"
			bg_color="#bg_tertiary" bg_opa="100%"
			border_width="0"
			pad_all="0"
		/>
		<style name="style_pressed"
			bg_color="#accent" bg_opa="40%"
		/>
		<style name="style_icon"
			image_recolor="#text_primary" image_recolor_opa="100%"
		/>
	</styles>

	<view extends="lv_button">
		<remove_style_all />
		<style name="style_btn" />
		<style name="style_pressed" selector="pressed" />

		<lv_image src="$icon" align="center">
			<style name="style_icon" />
		</lv_image>
	</view>
</component>
