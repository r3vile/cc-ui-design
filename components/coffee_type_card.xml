<component>
	<api>
		<prop name="icon" type="image" default="icon_espresso" />
		<prop name="label" type="string" default="Espresso" />
	</api>

	<styles>
		<style name="style_card"
			width="120" height="140"
			radius="16"
			bg_color="#bg_secondary" bg_opa="100%"
			border_width="1" border_color="#bg_tertiary" border_opa="100%"
			pad_all="#unit_md"
			layout="flex" flex_flow="column"
			flex_cross_place="center"
			flex_main_place="center"
			pad_row="#unit_sm"
		/>
		<style name="style_icon"
			image_recolor="#accent" image_recolor_opa="100%"
		/>
		<style name="style_label"
			text_color="#text_primary" text_font="font_caption"
			text_align="center"
		/>
	</styles>

	<view>
		<remove_style_all />
		<style name="style_card" />

		<lv_image src="$icon">
			<style name="style_icon" />
		</lv_image>
		<lv_label text="$label">
			<style name="style_label" />
		</lv_label>
	</view>
</component>
